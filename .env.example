# ── API Backend ───────────────────────────────────────────────────
# En développement local : laisser vide → proxy Vite (/api → localhost:8000)
# En production Vercel   : OBLIGATOIRE — URL exacte du backend Render
#   VITE_API_URL=https://mamy-khaliqa-backend.onrender.com
#
# Pourquoi ? Le proxy Vercel (rewrites) ne transmet pas les Set-Cookie du backend,
# ce qui empêche le cookie csrftoken d'atteindre le navigateur.
# Les appels cross-site directs avec credentials:"include" sont la bonne approche.
VITE_API_URL=

# URL publique du site (liens WhatsApp, Open Graph, réinitialisation mdp)
VITE_SITE_URL=http://localhost:5173
